#!/bin/bash
# musl-noan-c++ — compile a C++ program statically against musl for NoanOS
#
# Usage: musl-noan-c++ [source.cpp ...] -o output
#
# Produces a statically-linked ELF32 binary loadable by elf_load_file() and
# runnable via the SYS_EXEC_ELF (31) syscall or the `run` shell command.
#
# Segments are linked at 0x08000000, inside the per-process user virtual
# address space (0x08000000–0xBFFFFFFF).
#
# Runtime model
# -------------
#   C library  : musl libc (statically linked)
#   C++ library: system libstdc++ (statically linked) + libsupc++
#   Shim layer : musl-noan-cxx-shim/ overrides glibc-specific libstdc++
#                target headers (os_defines.h, c++locale.h) so they work
#                with musl instead of glibc.
#   Stubs      : libnoan_cxx_stubs.a provides thin replacements for glibc
#                symbols that the precompiled libstdc++.a references but
#                musl does not supply (__libc_single_threaded, arc4random,
#                __isoc23_strtoul, pthread_once, _dl_find_object, etc.)
#
# Supported C++ features
# ----------------------
#   - Classes, templates, operator overloading, references
#   - Virtual functions and vtables
#   - new / delete (backed by musl malloc/free)
#   - std::string, std::vector, std::array, and most <algorithm> headers
#   - Exceptions and RTTI (via libsupc++)
#   - Static constructors/destructors (via crt1.o / crtn.o)
#
# Limitations
# -----------
#   - No threads (pthread stubs are no-ops; std::thread will not work)
#   - No std::random_device entropy (arc4random stub is a simple LCG)
#   - Locale-dependent std:: features (std::locale, std::codecvt) are
#     stubbed out and will produce empty/default results
#   - No dynamic linking, no dlopen/dlsym

MUSL=/root/NoanOS/musl-noan
SHIM="$(dirname "$(readlink -f "$0")")/musl-noan-cxx-shim"
CXX=i686-linux-gnu-g++
GCC_LIB=/usr/lib/gcc-cross/i686-linux-gnu/14
CXX_INC=/usr/i686-linux-gnu/include/c++/14

exec $CXX \
  -m32 -march=i686 \
  -static \
  -nostdlib \
  -nostdinc \
  -I"$SHIM" \
  -I"$CXX_INC" \
  -I"$CXX_INC/i686-linux-gnu" \
  -I"$GCC_LIB/include" \
  -I"$MUSL/include" \
  -Wl,-Ttext-segment=0x08000000 \
  "$MUSL/lib/crt1.o" \
  "$MUSL/lib/crti.o" \
  "$@" \
  "$GCC_LIB/libstdc++.a" \
  "$GCC_LIB/libsupc++.a" \
  "$MUSL/lib/libc.a" \
  "$MUSL/lib/libnoan_cxx_stubs.a" \
  "$MUSL/lib/crtn.o" \
  -lgcc -lgcc_eh
