#!/bin/bash
# musl-noan-cc — compile a C program statically against musl for NoanOS
#
# Usage: musl-noan-cc [source.c ...] -o output
#
# The binary will be loadable by elf_load_file() and runnable via
# the SYS_EXEC_ELF (31) syscall or the `run` shell command.
#
# Segments are linked at 0x08000000, inside the per-process user virtual
# address space (0x08000000–0xBFFFFFFF).  Each process has its own page
# directory; the ELF loader allocates fresh physical frames and maps them
# at whatever vaddr the ELF requests, so the load address is not
# constrained by the kernel's identity-mapped region.

MUSL=/root/NoanOS/musl-noan
CC=i686-linux-gnu-gcc

exec $CC \
  -m32 -march=i686 \
  -static \
  -nostdlib \
  -I$MUSL/include \
  -Wl,-Ttext-segment=0x08000000 \
  $MUSL/lib/crt1.o \
  $MUSL/lib/crti.o \
  "$@" \
  $MUSL/lib/libc.a \
  $MUSL/lib/crtn.o \
  -lgcc -lgcc_eh
